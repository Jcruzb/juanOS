NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173
JUANOS_DOMAIN=juanos.example.com
DATABASE_URL=postgresql://juanos:change-me@localhost:5432/juanos
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_IDLE_MINUTES=30
PROJECTS_ROOT=/srv/juanos/projects
DEPLOY_LOGS_DIR=/var/lib/juanos/deployments
DEPLOY_LOGS_HOST_PATH=/var/lib/juanos/deployments
PROJECTS_CONTAINER_PATH=/srv/juanos/projects
POSTGRES_HOST_PORT=5433
API_HOST_PORT=4000
WEB_HOST_PORT=5173
EMBEDDED_WORKER=0
# JUANOS_RECOVERY_HELPER=/usr/local/libexec/juanos-recovery
# JUANOS_HOST_HELPER=/usr/local/libexec/juanos-host-action
JUANOS_HOST_HELPER_USE_SUDO=1
JUANOS_VERSION=0.1.0
# VPS_PUBLIC_IP=203.0.113.10
# JUANOS_SELF_UPDATE_HELPER=/usr/local/libexec/juanos-self-update
# Opcional y solo lectura durante la migración:
# JC_DEPLOY_INDEX_PATH=/imports/apps.json
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
# Opcional: clone de JuanOS dentro de PROJECTS_HOST_PATH para mostrar/proteger "ESTA APLICACIÓN".
# JUANOS_PROJECT_PATH=/srv/juanos/projects/juanos
# JUANOS_REPOSITORY_URL=https://github.com/owner/juanos.git
# JUANOS_DEFAULT_BRANCH=main
TRUST_PROXY=0
