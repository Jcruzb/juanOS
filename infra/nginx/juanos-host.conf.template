map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

limit_req_zone $binary_remote_addr zone=juanos_api_limit:10m rate=30r/s;

server {
  listen 80;
  listen [::]:80;
  server_name JUANOS_DOMAIN;

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    proxy_pass http://127.0.0.1:5173;
    proxy_set_header Host $host;
  }
}

# Después de obtener el certificado, el helper genera/actualiza el vhost definitivo
# desde /etc/juanos/host-policy.json y valida nginx -t antes de recargar.
