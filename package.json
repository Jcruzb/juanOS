{
  "name": "juanos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm run dev -w @juanos/web\" \"npm run dev -w @juanos/api\"",
    "build": "npm run build -w @juanos/shared && npm run build -w @juanos/api && npm run build -w @juanos/web",
    "lint": "eslint apps packages --max-warnings=0",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @juanos/api",
    "format": "prettier --write \"{apps,packages}/**/*.{js,jsx,json,css}\" \"docs/**/*.md\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.4.0",
    "prettier": "^3.6.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
