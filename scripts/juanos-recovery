#!/usr/bin/env node

import crypto from "node:crypto";
import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import { spawn } from "node:child_process";

const CONFIG_PATH = "/etc/juanos/recovery.json";
const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
const SNAPSHOT_FILE = /^[0-9a-f-]{36}-[0-9TZ.-]+\.tar\.age$/i;

function fail(message, code = 2) {
  process.stderr.write(`${message}\n`);
  process.exit(code);
}

function readRootFile(filePath, label) {
  const stat = fs.lstatSync(filePath);
  if (!stat.isFile() || stat.isSymbolicLink() || stat.uid !== 0 || (stat.mode & 0o022) !== 0) {
    fail(`${label} debe ser un archivo root-owned no modificable`);
  }
  return fs.readFileSync(filePath, "utf8");
}

function readConfig() {
  const value = JSON.parse(readRootFile(process.env.JUANOS_RECOVERY_CONFIG || CONFIG_PATH, "Configuración recovery"));
  if (value.version !== 1) fail("Configuración recovery incompatible");
  if (!path.isAbsolute(value.recoveryRoot || "")) fail("recoveryRoot inválido");
  if (!/^[A-Za-z0-9_-]+$/.test(value.rclone?.remote || "")) fail("Remote rclone inválido");
  if (!value.rclone?.basePath || value.rclone.basePath.includes("..") || value.rclone.basePath.startsWith("/")) {
    fail("Ruta base rclone inválida");
  }
  if (!String(value.age?.recipient || "").startsWith("age1")) fail("Destinatario age inválido");
  return value;
}

function command(executable, args, options = {}) {
  return new Promise((resolve, reject) => {
    const child = spawn(executable, args, {
      cwd: options.cwd,
      env: {
        PATH: "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
        ...(options.env || {})
      },
      shell: false,
      stdio: ["ignore", "pipe", "pipe"]
    });
    let stdout = "";
    let stderr = "";
    child.stdout.on("data", (chunk) => { stdout = (stdout + chunk).slice(-1_000_000); });
    child.stderr.on("data", (chunk) => { stderr = (stderr + chunk).slice(-1_000_000); });
    child.on("error", reject);
    child.on("close", (exitCode) => {
      if (exitCode === 0) resolve({ stdout, stderr });
      else reject(new Error(`${executable} terminó con código ${exitCode}: ${stderr.slice(-2000)}`));
    });
  });
}

function checksum(filePath) {
  const hash = crypto.createHash("sha256");
  hash.update(fs.readFileSync(filePath));
  return hash.digest("hex");
}

function safeDestination(value) {
  if (!value || path.isAbsolute(value) || value.split(/[\\/]/).includes("..")) fail("Destino de recovery inválido");
  return value;
}

async function copyIncludedPaths(config, bundleRoot) {
  const copied = [];
  for (const entry of config.includePaths || []) {
    if (!path.isAbsolute(entry.source || "")) fail("Origen de recovery no absoluto");
    const source = fs.realpathSync(entry.source);
    const destination = safeDestination(entry.destination);
    const target = path.join(bundleRoot, destination);
    fs.mkdirSync(path.dirname(target), { recursive: true, mode: 0o700 });
    const stat = fs.lstatSync(source);
    if (stat.isSymbolicLink()) fail("Recovery no copia symlinks configurados");
    if (stat.isDirectory()) {
      const excludes = config.includeEnvironmentSecrets
        ? ["--exclude", "*.key"]
        : [
            "--exclude", "*.key", "--exclude", ".env", "--exclude", ".env.*",
            "--exclude", "*secret*", "--exclude", "*.pgpass"
          ];
      await command("rsync", ["-a", "--safe-links", ...excludes, `${source}/`, `${target}/`]);
    } else if (stat.isFile()) {
      fs.copyFileSync(source, target);
      fs.chmodSync(target, 0o600);
    } else fail("Origen de recovery no regular");
    copied.push(destination);
  }
  return copied;
}

async function dumpDatabase(config, target) {
  const database = config.postgres;
  if (!database?.database || !database?.user) fail("PostgreSQL recovery no configurado");
  const args = ["--format=custom", "--file", target, "--username", database.user];
  if (database.host) args.push("--host", database.host);
  if (database.port) args.push("--port", String(database.port));
  args.push(database.database);
  const environment = {};
  if (database.pgpassFile) {
    readRootFile(database.pgpassFile, "PGPASSFILE");
    environment.PGPASSFILE = database.pgpassFile;
  }
  await command("pg_dump", args, { env: environment });
  const stat = fs.statSync(target);
  if (!stat.isFile() || stat.size === 0) fail("El dump PostgreSQL está vacío");
  await command("pg_restore", ["--list", target]);
}

function fileManifest(root) {
  const entries = [];
  const visit = (directory) => {
    for (const item of fs.readdirSync(directory, { withFileTypes: true })) {
      const target = path.join(directory, item.name);
      if (item.isDirectory()) visit(target);
      if (item.isFile()) {
        const relative = path.relative(root, target);
        const stat = fs.statSync(target);
        entries.push({ path: relative, size: stat.size, checksum: checksum(target) });
      }
    }
  };
  visit(root);
  return entries.sort((left, right) => left.path.localeCompare(right.path));
}

async function createSnapshot(config, snapshotId) {
  const recoveryRoot = config.recoveryRoot;
  fs.mkdirSync(recoveryRoot, { recursive: true, mode: 0o700 });
  fs.chmodSync(recoveryRoot, 0o700);
  const staging = fs.mkdtempSync(path.join(os.tmpdir(), "juanos-recovery-"));
  fs.chmodSync(staging, 0o700);
  const bundle = path.join(staging, "bundle");
  fs.mkdirSync(bundle, { mode: 0o700 });
  try {
    const databasePath = path.join(bundle, "database.dump");
    await dumpDatabase(config, databasePath);
    await copyIncludedPaths(config, bundle);
    const manifest = {
      version: 1,
      snapshotId,
      createdAt: new Date().toISOString(),
      juanosVersion: config.juanosVersion || "unknown",
      encrypted: true,
      includesEnvironmentSecrets: Boolean(config.includeEnvironmentSecrets),
      files: fileManifest(bundle)
    };
    fs.writeFileSync(path.join(bundle, "manifest.json"), `${JSON.stringify(manifest, null, 2)}\n`, { mode: 0o600 });
    const timestamp = new Date().toISOString().replace(/[:]/g, "-");
    const baseName = `${snapshotId}-${timestamp}.tar`;
    const archive = path.join(staging, baseName);
    const encrypted = path.join(recoveryRoot, `${baseName}.age`);
    await command("tar", ["-C", bundle, "-cf", archive, "."]);
    await command("age", ["--recipient", config.age.recipient, "--output", encrypted, archive]);
    fs.chmodSync(encrypted, 0o600);
    const encryptedChecksum = checksum(encrypted);
    const remoteFile = path.basename(encrypted);
    const remotePath = `${config.rclone.remote}:${config.rclone.basePath.replace(/\/+$/, "")}/${remoteFile}`;
    await command("rclone", ["copyto", encrypted, remotePath, "--checksum"]);
    const remote = await command("rclone", ["lsjson", remotePath]);
    const parsed = JSON.parse(remote.stdout || "[]");
    if (!(Array.isArray(parsed) ? parsed.length === 1 : parsed)) fail("El snapshot no existe en remoto");
    const verification = path.join(staging, `verify-${remoteFile}`);
    await command("rclone", ["copyto", remotePath, verification, "--checksum"]);
    if (checksum(verification) !== encryptedChecksum) fail("Checksum remoto distinto");
    return {
      status: "available",
      remoteProvider: config.rclone.provider || "rclone",
      remotePath: remoteFile,
      localPath: encrypted,
      checksum: encryptedChecksum,
      size: fs.statSync(encrypted).size,
      encryption: "age",
      manifest
    };
  } finally {
    fs.rmSync(staging, { recursive: true, force: true });
  }
}

async function verifySnapshot(config, remoteFile, expectedChecksum) {
  if (!SNAPSHOT_FILE.test(remoteFile) || !/^[a-f0-9]{64}$/.test(expectedChecksum || "")) {
    fail("Referencia de snapshot no válida");
  }
  const staging = fs.mkdtempSync(path.join(os.tmpdir(), "juanos-verify-"));
  fs.chmodSync(staging, 0o700);
  try {
    const encrypted = path.join(staging, remoteFile);
    const remotePath = `${config.rclone.remote}:${config.rclone.basePath.replace(/\/+$/, "")}/${remoteFile}`;
    await command("rclone", ["copyto", remotePath, encrypted, "--checksum"]);
    if (checksum(encrypted) !== expectedChecksum) fail("Checksum del snapshot no coincide");
    const archive = path.join(staging, "bundle.tar");
    readRootFile(config.age.identityFile, "Identidad age");
    await command("age", ["--decrypt", "--identity", config.age.identityFile, "--output", archive, encrypted]);
    const entries = await command("tar", ["-tf", archive]);
    if (!entries.stdout.split("\n").some((entry) => /(^|\/)manifest\.json$/.test(entry))) fail("Falta manifest.json");
    if (!entries.stdout.split("\n").some((entry) => /(^|\/)database\.dump$/.test(entry))) fail("Falta database.dump");
    const extracted = path.join(staging, "extracted");
    fs.mkdirSync(extracted, { mode: 0o700 });
    await command("tar", ["-C", extracted, "-xf", archive]);
    const manifest = JSON.parse(fs.readFileSync(path.join(extracted, "manifest.json"), "utf8"));
    if (manifest.version !== 1 || !Array.isArray(manifest.files)) fail("Manifest incompatible");
    for (const entry of manifest.files) {
      const relative = safeDestination(entry.path);
      const target = path.resolve(extracted, relative);
      if (!target.startsWith(`${extracted}${path.sep}`) || checksum(target) !== entry.checksum) {
        fail(`Integridad inválida: ${relative}`);
      }
    }
    await command("pg_restore", ["--list", path.join(extracted, "database.dump")]);
    return { status: "verified", verifiedAt: new Date().toISOString(), manifest };
  } finally {
    fs.rmSync(staging, { recursive: true, force: true });
  }
}

if (process.getuid?.() !== 0) fail("Recovery debe ejecutarse como root");
const [action, ...argv] = process.argv.slice(2);
const config = readConfig();
const valueFor = (flag) => {
  const index = argv.indexOf(flag);
  return index >= 0 ? argv[index + 1] : null;
};

if (action === "create") {
  const snapshotId = valueFor("--snapshot") || valueFor("--deployment");
  if (!UUID.test(snapshotId || "")) fail("ID de snapshot no válido");
  createSnapshot(config, snapshotId).then((result) => process.stdout.write(`${JSON.stringify(result)}\n`))
    .catch((error) => fail(error.message, 1));
} else if (action === "verify") {
  verifySnapshot(config, valueFor("--remote-file"), valueFor("--checksum"))
    .then((result) => process.stdout.write(`${JSON.stringify(result)}\n`))
    .catch((error) => fail(error.message, 1));
} else {
  fail("Uso: juanos-recovery {create --snapshot UUID|verify --remote-file FILE --checksum SHA256}");
}
